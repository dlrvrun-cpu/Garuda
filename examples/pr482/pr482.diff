diff --git a/force-app/main/default/classes/DiscountService.cls b/force-app/main/default/classes/DiscountService.cls
new file mode 100644
index 0000000..c92b205
--- /dev/null
+++ b/force-app/main/default/classes/DiscountService.cls
@@ -0,0 +1,18 @@
+public class DiscountService {
+    public static void recalc(List<Opportunity> opps) {
+        for (Opportunity o : opps) {
+            Account a = [SELECT Tier__c FROM Account WHERE Id = :o.AccountId];
+            o.Discount_Percent__c = tierDiscount(a.Tier__c);
+        }
+    }
+
+    @TestVisible
+    private static Decimal tierDiscount(String tier) {
+        Map<String, Decimal> rates = new Map<String, Decimal>{
+            'Gold' => 15,
+            'Silver' => 10,
+            'Bronze' => 5
+        };
+        return rates.containsKey(tier) ? rates.get(tier) : 0;
+    }
+}
diff --git a/force-app/main/default/classes/DiscountServiceTest.cls b/force-app/main/default/classes/DiscountServiceTest.cls
